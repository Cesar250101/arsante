<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="arsante.dispositivos_medicos_wizard_form_archivar" model="ir.ui.view">
        <field name="name">arsante.dispositivos.medicos.wizard.form.archivar</field>
        <field name="model">arsante.dispositivos_medicos_wizard</field>
        <field name="arch" type="xml">
            <form string="Crear nota de venta">
                <group>
                    <!--<field name="action" />-->
                    <div>
                        Se crear una nota de venta con las registros seleccionados
                    </div>
                </group>
                <footer>
                        <button string="Archivar" name="archivar" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
            </form>
        </field>
    </record>

    <record id="arsante.dispositivos_medicos_wizard_form_desarchivar" model="ir.ui.view">
        <field name="name">arsante.dispositivos.medicos.wizard.form.desarchivar</field>
        <field name="model">arsante.dispositivos_medicos_wizard</field>
        <field name="arch" type="xml">
            <form string="Crear nota de venta">
                <group>
                    <!--<field name="action" />-->
                    <div>
                        Se crear una nota de venta con las registros seleccionados
                    </div>
                </group>
                <footer>
                        <button string="Desarchivar" name="desarchivar" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
            </form>
        </field>
    </record>

    
    <record id="arsante.dispositivos_medicos_wizard_form" model="ir.ui.view">
        <field name="name">arsante.dispositivos.medicos.wizard.form</field>
        <field name="model">arsante.dispositivos_medicos_wizard</field>
        <field name="arch" type="xml">
            <form string="Crear nota de venta">
                <group>
                    <!--<field name="action" />-->
                    <div>
                        Se crear una nota de venta con las registros seleccionados
                    </div>
                </group>
                <footer>
                        <button string="Aceptar" name="create_so" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
            </form>
        </field>
    </record>

    <record id="arsante.dispositivos_medicos_wizard_action" model="ir.actions.act_window">
        <field name="name">Crear nota de venta</field>
        <field name="res_model">arsante.dispositivos_medicos_wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="dispositivos_medicos_wizard_form"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="binding_model_id" ref="model_arsante_dispositivos_medicos_wizard"/>
        <field name="binding_view_types">list</field>
    </record> 
    
</odoo>
