<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="arsante.dispositivos_medicos_wizard_form" model="ir.ui.view">
        <field name="name">arsante.dispositivos.medicos.wizard.form</field>
        <field name="model">arsante.dispositivos_medicos_wizard</field>
        <field name="arch" type="xml">
            <form string="Crear nota de venta">
                <group>
                    <!--<field name="action" />-->
                    <div>
                        Se crear una nota de venta con las registros seleccionados
                    </div>
                </group>
                <footer>
                        <button string="Aceptar" name="create_so" type="object" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
            </form>
        </field>
    </record>
    <act_window
        id="arsante.dispositivos_medicos_wizard_action"
        multi="True"
        key2="client_action_multi"
        name="Crear nota de venta"
        res_model="arsante.dispositivos_medicos_wizard"
        src_model="arsante.dispositivos_medicos"
        view_mode="form"
        target="new"
        view_type="form"
    />
</odoo>
