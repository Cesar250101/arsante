<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="arsante_registro_asignar_form_view" model="ir.ui.view">
    <field name="name">arsante.registro.asignar.form</field>
    <field name="model">arsante.registro.asignar</field>
    <field name="arch" type="xml">
      <form string="Asignar registros" create="0" edit="0" delete="0">
        <group>
          <field name="registro_ids" widget="many2many_tags"/>
          <field name="company_id" invisible="1"/>
          <field name="usuario_id"
                 options="{'no_create': True, 'no_create_edit': True,
                           'no_open': True}"/>
        </group>
        <footer>
          <button name="action_asignar" string="Asignar" type="object"
                  class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
