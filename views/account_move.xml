    <record id="view_out_invoice_tree_inherit_arsante" model="ir.ui.view">
        <field name="name">account.move.out.invoice.tree.inherit.arsante</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="es_arsante" invisible="1"/>
                <field name="tipo_serv_registro" optional="hide" attrs="{'invisible': [('es_arsante', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>