<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_arsante" model="ir.ui.view">
        <field name="name">account.move.form.inherit.arsante</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="es_arsante" invisible="1"/>
                <field name="tipo_serv_registro" attrs="{'invisible': [('es_arsante', '=', False)]}"/>
            </xpath>
        </field>
    </record>
