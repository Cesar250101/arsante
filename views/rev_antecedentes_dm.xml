<odoo>
  <data>

    <record id="view_arsante_rev_antecedentes_dm_filter" model="ir.ui.view">
      <field name="name">view.arsante.rev.antecedentes.dm.filter</field>
      <field name="model">arsante.rev_antecedentes_dm</field>
      <field name="priority" eval="15"/>
      <field name="arch" type="xml">
        <search string="Buscar Rev. Antecedentes DM">
          <field name="partner_id"/>
          <field name="ref_gicona_isp"/>
          <field name="nro_registro"/>
          <field name="fabricante_id"/>
          <field name="nro_resolucion"/>
          <filter string="Activos" domain="[('active','=',True)]" name="active"/>
          <filter string="Archivados" domain="[('active','=',False)]" name="archivados"/>
          <filter string="Facturado" domain="[('facturado','=',True)]" name="facturado_filter"/>
          <filter string="No Facturado" domain="[('facturado','=',False)]" name="no_facturado_filter"/>
          <filter string="No Cotizado" domain="[('sale_order_id','=',False)]" name="no_cotizado_filter"/>
          <filter string="Cotizado" domain="[('sale_order_id','!=',False)]" name="cotizado_filter"/>
          <filter string="Docu. Completa" domain="[('documentacion','=','completa')]" name="completa_filter"/>
          <filter string="Docu. Incompleta" domain="['|',('documentacion','=','incompleta'),('documentacion','=',False)]" name="incompleta_filter"/>
          <filter string="Estado: Listo" domain="[('estado','=','listo')]" name="listo_filter"/>
          <filter string="Estado: No Listo" domain="['|',('estado','=','no_listo'),('estado','=',False)]" name="no_listo_filter"/>
          <filter string="Para Renovar" domain="[('alerta_renovacion','=',True)]" name="para_renovar"/>
          <group expand="0" string="Agrupar Por">
            <filter string="Cliente" name="partner_id" domain="[]" context="{'group_by':'partner_id'}"/>
            <filter name="fabricante_id" string="Fabricante" domain="[]" context="{'group_by':'fabricante_id'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- Vista Formulario -->
    <record model="ir.ui.view" id="arsante.rev_antecedentes_dm_form_view">
      <field name="name">Rev. Antecedentes DM</field>
      <field name="model">arsante.rev_antecedentes_dm</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group>
              <group>
                <field name="tipo_registro_id" required="1"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>

                <!-- Marca con botón URL OneDrive -->
                <field name="marca_url" invisible="1"/>
                <label for="marca"/>
                <div class="o_row">
                  <field name="marca" class="oe_inline"/>
                  <button name="open_marca_link" string="URL OneDrive" type="object"
                    icon="fa-folder-open" class="oe_link"
                    attrs="{'invisible': [('marca_url', '=', False)]}"/>
                </div>

                <field name="ref_gicona_isp"/>
                <field name="nro_registro"/>
                <field name="product_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <field name="fabricante_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>

                <!-- PDF Resolución con subir archivo y link de acceso carpeta -->
                <label for="pdf_resolucion"/>
                <div class="o_row">
                  <field name="pdf_resolucion" class="oe_inline"/>
                  <button name="open_pdf_resolucion_url" string="Link de Acceso Carpeta" type="object"
                    icon="fa-external-link" class="oe_link"
                    attrs="{'invisible': [('pdf_resolucion_url', '=', False)]}"/>
                </div>
                <field name="pdf_resolucion_url" placeholder="https://..."/>

                <field name="nro_resolucion"/>
                <field name="fecha_resolucion"/>

                <!-- Nota de Venta con OC Facturación y Facturas -->
                <label for="sale_order_id"/>
                <div class="o_row">
                  <field name="sale_order_id" class="oe_inline" nolabel="1"/>
                  <field name="oc_facturacion" class="oe_inline" placeholder="OC Facturacion" nolabel="1"
                    attrs="{'invisible': [('sale_order_id', '=', False)]}"/>
                  <field name="invoice_ids" widget="many2many_tags" class="oe_inline" nolabel="1"
                    attrs="{'invisible': [('sale_order_id', '=', False)]}"/>
                </div>

                <field name="correo_ids"/>
                <field name="comentario"/>
                <field name="alerta_renovacion" invisible="1"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Vista Lista -->
    <record model="ir.ui.view" id="arsante.rev_antecedentes_dm_tree_view">
      <field name="name">Rev. Antecedentes DM</field>
      <field name="model">arsante.rev_antecedentes_dm</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="date"/>
          <field name="partner_id"/>
          <field name="marca"/>
          <field name="ref_gicona_isp"/>
          <field name="nro_registro"/>
          <field name="product_id"/>
          <field name="fabricante_id"/>
          <field name="nro_resolucion"/>
          <field name="fecha_resolucion"/>
          <field name="sale_order_id"/>
          <field name="facturado" optional="hide"/>
          <field name="estado" optional="hide"/>
          <field name="alerta_renovacion" optional="hide"/>
        </tree>
      </field>
    </record>

    <!-- Vista Pivot -->
    <record model="ir.ui.view" id="arsante.rev_antecedentes_dm_pivot_view">
      <field name="name">Rev. Antecedentes DM</field>
      <field name="model">arsante.rev_antecedentes_dm</field>
      <field name="arch" type="xml">
        <pivot>
          <field name="partner_id" type="row"/>
        </pivot>
      </field>
    </record>

    <!-- Acción -->
    <record model="ir.actions.act_window" id="arsante.rev_antecedentes_dm_action_window">
      <field name="name">Rev. Antecedentes DM</field>
      <field name="res_model">arsante.rev_antecedentes_dm</field>
      <field name="view_mode">tree,form,pivot</field>
    </record>

    <!-- Acción server para crear nota de venta -->
    <record model="ir.actions.server" id="arsante.create_so_rev_antecedentes_dm_action_server">
      <field name="name">Crear Nota de Venta</field>
      <field name="type">ir.actions.server</field>
      <field name="model_id" ref="arsante.model_arsante_rev_antecedentes_dm"/>
      <field name="binding_model_id" ref="arsante.model_arsante_rev_antecedentes_dm"/>
      <field name="state">code</field>
      <field name="code">
        record.create_so()
      </field>
    </record>

    <!-- Menú -->
    <menuitem name="Rev. Antecedentes DM" id="arsante.rev_antecedentes_dm_menu_list"
              parent="arsante.arsante_menu_tipo_registros"
              sequence="23"
              action="arsante.rev_antecedentes_dm_action_window"/>

  </data>
</odoo>
