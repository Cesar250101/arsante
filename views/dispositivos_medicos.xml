<odoo>
  <data>
        <record id="view_arsante_dispositivos_medicos_filter" model="ir.ui.view">
            <field name="name">view.arsante.dispositivos.medicos.filter</field>
            <field name="model">arsante.dispositivos_medicos</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <search string="Search Sales Order">
                    <field name="partner_id"/>
                    <field name="fabricante_id"/>
                    <field name="nro_resolucion"/>
                    <filter string="Activos" domain="[('active','=',True)]" name="active"/>
                    <filter string="Archivados" domain="[('active','=',False)]" name="Activados"/>

                    <filter string="Facturado" domain="[('facturado','=',True)]" name="facturado_filter"/>
                    <filter string="No Facturado" domain="[('facturado','=',False)]" name="no_facturado_filter"/>
                    <filter string="No Cotizado" domain="[('sale_order_id','=',False)]" name="no_catizado_filter"/>
                    <filter string="Cotizado" domain="[('sale_order_id','!=',False)]" name="catizado_filter"/>
                    <filter string="Docu. Completa" domain="[('documentacion','=','completa')]" name="completa_filter"/>
                    <filter string="Docu. Incompleta" domain="['|',('documentacion','=','incompleta'),('documentacion','=',False)]" name="incompleta_filter"/>
                    <filter string="Estado: Listo" domain="[('estado','=','listo')]" name="listo_filter"/>
                    <filter string="Estado: No Listo" domain="['|',('estado','=','no_listo'),('estado','=',False)]" name="no_listo_filter"/>
                    <filter string="Para Renovar" domain="[('alerta_renovacion','=',True)]" name="para_renovar"/>

                    <group expand="0" string="Group By">
                        <filter string="Cliente" name="partner_id" domain="[]" context="{'group_by':'partner_id'}"/>
                        <filter name="product_id" string="Producto" domain="[]" context="{'group_by':'product_id'}"/>
                    </group>
               </search>
            </field>
        </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="arsante.dm_form_view">
      <field name="name">Dispositivos Medicos</field>
      <field name="model">arsante.dispositivos_medicos</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
           <!-- <button string="Obtener Facturas" name="get_invoice_ids" type="object" class="oe_highlight"/>  -->
          </header>
          <sheet>
            <group>
              <group>
                <field name="tipo_registro_id" required="1"/>
                <field name="name" placeholder="Este dato es importante para las busquedas, por esto debe ingresar un nombre que identifique el registro" required="1" invisible="1"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <!-- <field name="categoria"/> -->
                <!-- Marca con botón URL -->
                <field name="marca_url" invisible="1"/>
                <label for="marca"/>
                <div class="o_row">
                  <field name="marca" class="oe_inline"/>
                  <button name="open_marca_link" string="URL OneDrive" type="object"
                    icon="fa-folder-open" class="oe_link"
                    attrs="{'invisible': [('marca_url', '=', False)]}"/>
                </div>
                <field name="fabricante_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]" string="Proveedor"/>
                <field name="ref_gicona" string="Ref. Gicona (AU)"/>
                <field name="nro_items"/>
                <field name="fecha_ingreso" string="Fecha Llegada"/>
                <field name="agente_aduana_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <field name="nro_cda"/>
                <!-- <field name="ref_isp"/> -->
                <!-- <field name="nro_registro"/> -->
                <field name="product_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                 <field name="pdf_nro_resolucion" widget="binary" filename="nro_resolucion.pdf" string="PDF Resolución" />
                <field name="fecha_resolucion"/>                
                <field name="nro_resolucion"/>
                <!-- <field name="fecha_ult_renovacion"/> -->
                <!-- <field name="fecha_vcto"/> -->
                <field name="au"/>
                <field name="cc_cesmec"/>

                <label for="sale_order_id"/>
                <div class="o_row">
                  <field name="sale_order_id" class="oe_inline" nolabel="1"/>
                  <field name="oc_facturacion" class="oe_inline" placeholder="OC Facturacion" nolabel="1"/>
                  <field name="invoice_ids" widget="many2many_tags" class="oe_inline" nolabel="1"
                    attrs="{'invisible': [('sale_order_id', '=', False)]}"/>
                </div>
                <field name="correo_ids"/>
                <field name="comentario"/>
                <!-- <field name="no_cotizado"/> -->
                  <!-- <field name="estado"/>
                  <field name="documentacion"/> -->
                  <field name="alerta_renovacion" invisible="1"/>
              </group>
              <group>
                <field name="imagen" widget="image" options="{'size': [300, 300]}"/>
              </group>
              <!-- <group>
                <field name="enviar_colilla"/>
                <field name="enviar_cliente"/>
                <field name="facturado"/>
                <field name="requiere_renovacion"/>
                <field name="fecha_renovacion" attrs="{'invisible': [('requiere_renovacion','=',False)]}"/>
              </group> -->
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="arsante.dm_tree_view">
      <field name="name">Dispositivos Medicos</field>
      <field name="model">arsante.dispositivos_medicos</field>
      <field name="arch" type="xml">
        <tree>
                <field name="name" required="1"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"/>
                <!-- <field name="categoria"/> -->
                <field name="marca"/>
                <field name="ref_isp"/>
                <field name="nro_registro"/>
                <field name="product_id"/>
                <field name="fabricante_id"/>
                <field name="fecha_ingreso"/>
                <field name="nro_resolucion"/>
                <!-- <field name="estado"/> -->
                <field name="fecha_resolucion"/>
                <!-- <field name="fecha_ult_renovacion"/> -->
                <!-- <field name="fecha_vcto"/>
                <field name="enviar_colilla"/>
                <field name="enviar_cliente"/>
                <field name="facturado"/> -->
                <!-- <field name="no_cotizado"/> -->
                <field name="sale_order_id"/>
                  <!-- <field name="documentacion"/> -->
          <!-- <field name="alerta_renovacion"/> -->
        </tree>
      </field>
    </record>

       <!-- explicit pivot definition -->

    <record model="ir.ui.view" id="arsante.dm_pivot_view">
      <field name="name">Dispositivos Medicos</field>
      <field name="model">arsante.dispositivos_medicos</field>
      <field name="arch" type="xml">
        <pivot>
          <field name="partner_id" type="row"/>
        </pivot>
      </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="arsante.dm_action_window">
      <field name="name">CDA de DM</field>
      <field name="res_model">arsante.dispositivos_medicos</field>
      <field name="view_mode">tree,form,pivot</field>
    </record>

    <record model="ir.actions.act_window" id="arsante.dm_action_window_no_facturados">
      <field name="name">Dispositivos Medicos - No Fcaturados</field>
      <field name="res_model">arsante.dispositivos_medicos</field>
      <field name="view_mode">tree,form,pivot</field>
      <field name="domain">[('facturado', '=', False)]</field>
    </record>

    <!-- Accion que crear las notas de ventas de varios registros seleccionados en la vista tree -->
    <record model="ir.actions.server" id="arsante.create_so_dispositivos_medicos_action_server">
        <field name="name">Crear Nota de Venta</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="arsante.model_arsante_dispositivos_medicos"/>
        <field name="binding_model_id" ref="arsante.model_arsante_dispositivos_medicos"/>
        <field name="state">code</field>
        <field name="code">
          record.create_so()
        </field>
      </record>

    <!-- actions -->
    <menuitem name="CDA de DM" id="arsante.dm_menu_list" parent="arsante.arsante_menu_tipo_registros"
              sequence="20"
              action="arsante.dm_action_window"/>

  </data>
</odoo>
