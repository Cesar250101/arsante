<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_company_form_arsante" model="ir.ui.view">
        <field name="name">res.company.form.arsante</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group/group[last()]" position="after">
                <group>
                    <field name="es_arsante"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
