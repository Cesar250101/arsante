<odoo>
  <data>

    <!-- Vista Kanban -->
    <record id="tipo_registro_kanban_view" model="ir.ui.view">
      <field name="name">tipo.registro.kanban.view</field>
        <field name="model">arsante.tipo_registro</field>
        <field name="arch" type="xml">
        <kanban class="o_res_partner_kanban">
          <field name="id"/>
          <field name="name"/>
          <field name="total_record_count"/>
          <field name="facturados"/>
          <field name="no_facturados"/>
          <field name="cotizados"/>
          <field name="no_cotizados"/>
          <field name="estado_listos"/>
          <field name="estado_no_listos"/>
          <field name="documentacion_completa"/>
          <field name="documentacion_completa_no_completa"/>
          <field name="tipo"/>
          <field name="para_renovar"/>

          <templates>
            <t t-name="kanban-box">
              <div t-attf-class="oe_kanban_global_click">
                <div class="oe_kanban_details">
                  <!--
                    Antes apuntaba a open_tree_cda_cosmeticos, que mapeaba a mano
                    cada tipo con su modelo mediante 20 ifs. Ahora hay un solo
                    modelo y la acción la construye action_open_registros.
                  -->
                  <a name="action_open_registros" title="Ver registros"
                     type="object" class="text-center">
                      <h3><field name="name"/></h3>
                  </a><br></br>

                  <i class="fa fa-check"></i>
                  <span>Total Registros: </span> <t t-esc="record.total_record_count.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span class="text-primary">Facturados: </span> <t t-esc="record.facturados.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>No Facturados: </span> <t t-esc="record.no_facturados.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>Cotizados: </span> <t t-esc="record.cotizados.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>No Cotizados: </span> <t t-esc="record.no_cotizados.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>Listos: </span> <t t-esc="record.estado_listos.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>No Listos: </span> <t t-esc="record.estado_no_listos.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>Doc. Completa: </span> <t t-esc="record.documentacion_completa.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span>Doc. No Completa: </span> <t t-esc="record.documentacion_completa_no_completa.value"/><br></br>
                  <i class="fa fa-check"></i>
                  <span  class="text-success">Para Renovar: </span> <t t-esc="record.para_renovar.value"/><br></br>

                </div>
              </div>
            </t>
                        <!-- For purchase and sale -->
            <div class="row">
                             <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                <div class="o_kanban_card_manage_title">
                                    <span>View</span>
                                </div>
                                <div>
                                    <a t-if="journal_type == 'sale'" type="object" name="open_action" context="{'use_domain': [('type', '=', 'out_invoice')]}">Invoices</a>
                                    <a t-if="journal_type == 'purchase'" type="object" name="open_action" context="{'use_domain': [('type', '=', 'in_invoice')]}">Bills</a>
                                </div>
                                <div>
                                    <a t-if="journal_type == 'sale'" type="object" name="open_action" context="{'use_domain': [('type', '=', 'out_refund')], 'invoice_type': 'refund'}">Credit Notes</a>
                                    <a t-if="journal_type == 'purchase'" type="object" name="open_action" context="{'use_domain': [('type', '=', 'in_refund')], 'invoice_type': 'refund'}">Credit Notes</a>
                                </div>
                                <div>
                                    <a type="object" name="action_open_reconcile">Payments Matching</a>
                                </div>
                                <div>
                                    <a type="object" name="open_action" context="{'action_name': 'action_account_moves_all_a'}" groups="base.group_no_one">Journal Items</a>
                                </div>
                            </div>

                             <div class="col-4 o_kanban_card_manage_section o_kanban_manage_new">
                                <div class="o_kanban_card_manage_title">
                                    <span>New</span>
                                </div>
                                <div>
                                    <a type="object" name="action_create_new">
                                        <span t-if="journal_type == 'sale'">Invoice</span>
                                        <span t-if="journal_type == 'purchase'">Bill</span>
                                    </a>
                                </div>
                                <div>
                                    <a type="object" name="action_create_new" context="{'refund':True}">
                                        <span t-if="journal_type == 'sale'">Credit Note</span>
                                        <span t-if="journal_type == 'purchase'">Credit Note Bill</span>
                                    </a>
                                </div>
                            </div>

                             <div class="col-4 o_kanban_card_manage_section o_kanban_manage_reports">
                                <div class="o_kanban_card_manage_title">
                                    <span>Reporting</span>
                                </div>
                                <div>
                                    <a t-if="journal_type == 'sale'" type="action" name="362" groups="account.group_account_manager">Invoices Analysis</a>
                                    <a t-if="journal_type == 'purchase'" type="action" name="361" groups="account.group_account_manager">Bills Analysis</a>
                                </div>
                            </div>
                        </div>

          </templates>
        </kanban>
        </field>
    </record>

     <!-- explicit list view definition -->
    
    <record model="ir.ui.view" id="arsante.tipos_registro_tree_view">
      <field name="name">Tipos de Registro</field>
      <field name="model">arsante.tipo_registro</field>
      <field name="arch" type="xml">
        <tree editable ='bottom'>
          <field name="name" required="1"/>
          <field name="tipo" required="1"/>
          <field name="total_record_count"/>
          <field name="facturados"/>
            <field name="no_facturados"/>
            <field name="cotizados"/>
            <field name="no_cotizados"/>
            <field name="estado_listos"/>
            <field name="estado_no_listos"/>
            <field name="documentacion_completa"/>
            <field name="documentacion_completa_no_completa"/>
            <field name="active"/>
        </tree>
      </field>
    </record>

    <!-- Vista Pivot -->
    <record id="tipo_registro_pivot_view" model="ir.ui.view">
        <field name="name">arsante.tipo_registro.pivot</field>
        <field name="model">arsante.tipo_registro</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Registros">
                <field name="name" type="row"/>
                <field name="total_record_count" type="measure"/>
                <field name="facturados" type="measure"/>
                <field name="no_facturados" type="measure"/>
                <field name="cotizados" type="measure"/>
                <field name="no_cotizados" type="measure"/>
                <field name="para_renovar" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vista Graph -->
    <record id="tipo_registro_graph_view" model="ir.ui.view">
        <field name="name">arsante.tipo_registro.graph</field>
        <field name="model">arsante.tipo_registro</field>
        <field name="arch" type="xml">
            <graph string="Estadísticas de Registros" type="bar">
                <field name="name"/>
                <field name="total_record_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="tipos_registro_search_view" model="ir.ui.view">
      <field name="name">arsante.tipo_registro.search</field>
      <field name="model">arsante.tipo_registro</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="tipo"/>
          <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
          <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
          <group expand="0" string="Group By">
            <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo'}"/>
          </group>
        </search>
      </field>
    </record>

    <!--
      Este archivo absorbe el contenido de views/tipo_regitro.xml (errata en el
      nombre), que era el que realmente estaba activo: aquí la acción y el menú
      estaban comentados, y ambos ficheros declaraban los mismos external ID
      pisándose el uno al otro.
    -->

    <!-- Limpia menús duplicados creados a mano, sin external ID -->
    <delete model="ir.ui.menu"
            search="[('name', '=', 'Tipos de Registro'), ('parent_id.name', '=', 'Tipo de Registros')]"/>

    <record model="ir.actions.act_window" id="arsante.tipo_registro_action_window">
      <field name="name">Tipos de Registro</field>
      <field name="res_model">arsante.tipo_registro</field>
      <!-- form incluido: es donde el usuario define los campos de cada trámite -->
      <field name="view_mode">kanban,tree,form,pivot,graph</field>
    </record>

    <menuitem name="Tipos de Registro"
              id="arsante.tipo_registro_menu_list"
              sequence="99"
              parent="arsante.arsante_menu_tipo_registros"
              action="arsante.tipo_registro_action_window"/>

  </data>
</odoo>