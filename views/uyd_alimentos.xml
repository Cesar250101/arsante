<odoo>
  <data>
        <record id="view_arsante_uyd_alimentos_filter" model="ir.ui.view">
            <field name="name">view.arsante.uyd.alimentos.filter</field>
            <field name="model">arsante.uyd_alimentos</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <search string="Search Sales Order">
                    <field name="partner_id"/>
                    <field name="au"/>
                    <field name="nro_uyd"/>
                    <field name="product_id"/>
                    <field name="proveedor_id"/>
                    <field name="agente_aduana_id"/>
                    <field name="marca"/>
                    <filter string="Activos" domain="[('active','=',True)]" name="active"/>
                    <filter string="Archivados" domain="[('active','=',False)]" name="Activados"/>

                    <filter string="Facturado" domain="[('facturado','=',True)]" name="facturado_filter"/>
                    <filter string="No Facturado" domain="[('facturado','=',False)]" name="no_facturado_filter"/>
                    <filter string="No Cotizado" domain="[('sale_order_id','=',False)]" name="no_catizado_filter"/>
                    <filter string="Cotizado" domain="[('sale_order_id','!=',False)]" name="catizado_filter"/>
                    <filter string="Docu. Completa" domain="[('documentacion','=','completa')]" name="completa_filter"/>
                    <filter string="Docu. Incompleta" domain="['|',('documentacion','=','incompleta'),('documentacion','=',False)]" name="incompleta_filter"/>
                    <filter string="Estado: Listo" domain="[('estado','=','listo')]" name="listo_filter"/>
                    <filter string="Estado: No Listo" domain="['|',('estado','=','no_listo'),('estado','=',False)]" name="no_listo_filter"/>
                    <filter string="Para Renovar" domain="[('alerta_renovacion','=',True)]" name="para_renovar"/>

                    <group expand="0" string="Group By">
                        <filter string="Cliente" name="cliente" domain="[]" context="{'group_by':'partner_id'}"/>
                        <filter name="product_id" string="Producto" domain="[]" context="{'group_by':'product_id'}"/>
                    </group>
               </search>
            </field>
        </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="arsante.uyd_alimentos_form_view">
      <field name="name">UYD Alimentos</field>
      <field name="model">arsante.uyd_alimentos</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
          </header>
          <sheet>
            <group>
              <group>
                <field name="tipo_registro_id" required="1"/>
                <field name="name" placeholder="Este dato es importante para las busquedas, por esto debe ingresar un nombre que identifique el registro" required="1" invisible="1"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <field name="marca_url" invisible="1"/>
                <label for="marca"/>
                <div class="o_row">
                  <field name="marca" class="oe_inline"/>
                  <button name="open_marca_link" string="URL OneDrive" type="object"
                     icon="fa-folder-open" class="oe_link"
                     attrs="{'invisible': [('marca_url', '=', False)]}"/>
                </div>
                <field name="proveedor_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <field name="product_id" required="1"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <field name="ref_tramite"/>
                <field name="item"/>
                <field name="fecha_llegada"/>
                <field name="agente_aduana_id"
                  domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"/>
                <field name="Bodega_llegada"/>
                <field name="fecha_resolucion_nro"/>
                <field name="nro_uyd"/>
                <field name="pdf_nro_resolucion"/>
                <field name="nro_resolucion"/>
                <label for="sale_order_id"/>
                <div class="o_row">
                  <field name="sale_order_id" class="oe_inline" nolabel="1"/>
                  <field name="oc_facturacion" class="oe_inline" placeholder="OC Facturacion" nolabel="1"/>
                  <field name="invoice_ids" widget="many2many_tags" class="oe_inline" nolabel="1"
                    attrs="{'invisible': [('sale_order_id', '=', False)]}"/>
                </div>
                <field name="correo_ids"/>
                <field name="comentario"/>
                <field name="exim_ctrl_calidad" invisible="1"/>
                <field name="espera_resolucion" invisible="1"/>
                  <field name="estado" invisible="1"/>
                  <field name="documentacion" invisible="1"/>
                  <field name="alerta_renovacion" invisible="1"/>
              </group>
              <group>
                <field name="va_cesmec" invisible="1"/>
                <label for="enviar_colilla" invisible="1"/>
                <div class="o_row" invisible="1">
                  <field name="enviar_colilla" placeholder="Envíar colilla?" />
                  <field name="enviar_colilla_fecha" placeholder="Fecha enviar colilla" attrs="{'invisible': [('enviar_colilla','=',False)]}"/>
                </div>
                <field name="enviar_cda" invisible="1"/>
                <field name="enviar_subir" invisible="1"/>
                <field name="facturado" invisible="1"/>
                <field name="subir_cloud" invisible="1"/>
                <field name="subir_drive" invisible="1"/>
                <field name="requiere_renovacion" invisible="1"/>
                <field name="fecha_renovacion" attrs="{'invisible': [('requiere_renovacion','=',False)]}"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="arsante.uyd_alimentos_tree_view">
      <field name="name">UYD Alimentos</field>
      <field name="model">arsante.uyd_alimentos</field>
      <field name="arch" type="xml">
        <tree>
                <field name="tipo_registro_id" required="1"/>
                <field name="name" required="1" optional="hide"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"/>
                <field name="nro_uyd"/>
                <field name="item"/>
                <field name="agente_aduana_id"/>
                <field name="ref_tramite"/>
                <field name="proveedor_id"/>
                <field name="marca"/>
                <field name="fecha_llegada"/>
                <field name="sale_order_id"/>
                <field name="exim_ctrl_calidad" optional="hide"/>
                <field name="facturado" optional="hide"/>
                <field name="subir_drive" optional="hide"/>
                <field name="espera_resolucion" optional="hide"/>
                  <field name="estado" optional="hide"/>
                  <field name="documentacion" optional="hide"/>
          <field name="alerta_renovacion"/>
        </tree>
      </field>
    </record>

    <!-- explicit pivot definition -->

    <record model="ir.ui.view" id="arsante.uyd_alimentos_pivot_view">
      <field name="name">UYD Alimentos</field>
      <field name="model">arsante.uyd_alimentos</field>
      <field name="arch" type="xml">
        <pivot>
          <field name="partner_id" type="row"/>
        </pivot>
      </field>
    </record>

    <!-- Accion que crear las notas de ventas de varios registros seleccionados en la vista tree -->
    <record model="ir.actions.server" id="arsante.create_so_uyd_alimentos_action_server">
        <field name="name">Crear Nota de Venta</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="arsante.model_arsante_uyd_alimentos"/>
        <field name="binding_model_id" ref="arsante.model_arsante_uyd_alimentos"/>
        <field name="state">code</field>
        <field name="code">
          record.create_so()
        </field>
      </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="arsante.uyd_alimentos_action_window">
      <field name="name">UYD Alimentos</field>
      <field name="res_model">arsante.uyd_alimentos</field>
      <field name="view_mode">tree,form,pivot</field>
    </record>

    <record model="ir.actions.act_window" id="arsante.uyd_alimentos_action_window_no_facturados">
      <field name="name">UYD Alimentos - No Facturado</field>
      <field name="res_model">arsante.uyd_alimentos</field>
      <field name="view_mode">tree,form,pivot</field>
      <field name="domain">[('facturado', '=', False)]</field>
    </record>

    <!-- actions -->
    <menuitem name="UYD Alimentos" id="arsante.uyd_alimentos_menu_list" parent="arsante.arsante_menu_tipo_registros"
              action="arsante.uyd_alimentos_action_window"/>

  </data>
</odoo>
