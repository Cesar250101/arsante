    <record id="view_order_form_arsante" model="ir.ui.view">
        <field name="name">view.order.form.arsante</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="es_arsante" invisible="1"/>
                <field name="fecha_pago" attrs="{'invisible': [('es_arsante', '=', False)]}"/>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="es_arsante" invisible="1"/>
                <field name="tipo_serv_registro" attrs="{'invisible': [('es_arsante', '=', False)]}"/>
            </xpath>

        </field>
    </record>


    <record id="view_quotation_tree_inherit_arsante" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.arsante</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='state']" position="before">
                <field name="es_arsante" invisible="1"/>
                <field name="tipo_serv_registro" optional="show" attrs="{'invisible': [('es_arsante', '=', False)], 'required': [('es_arsante', '=', True)]}"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_filter_inherit_arsante" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.arsante</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="es_arsante" invisible="1"/>
                <field name="tipo_registro_id" filter_domain="[('tipo_registro_id', 'ilike', self)]" attrs="{'invisible': [('es_arsante', '=', False)]}"/>
                <group expand="0" string="Group By">
                    <filter string="Tipo de Registro" name="group_by_tipo_registro_id" context="{'group_by':'tipo_registro_id'}" attrs="{'invisible': [('es_arsante', '!=', True)]}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>