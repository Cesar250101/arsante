<odoo>
  <data>
        <record id="view_arsante_modificacion_cosmetico_filter" model="ir.ui.view">
            <field name="name">view.arsante.registro.isp.filter</field>
            <field name="model">arsante.modificacion_cosmeticos</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <search string="Search Sales Order">
                    <field name="partner_id"/>
                    <field name="mc_ref_gicona"/>
                    <field name="product_id"/>
                    <field name="fabricante_id"/>
                    <field name="nro_resolucion"/>
                    <filter string="Activos" domain="[('active','=',True)]" name="active"/>
                    <filter string="Archivados" domain="[('active','=',False)]" name="Activados"/>

                    <filter string="Facturado" domain="[('facturado','=',True)]" name="facturado_filter"/>
                    <filter string="No Facturado" domain="[('facturado','=',False)]" name="no_facturado_filter"/>
                    <filter string="No Cotizado" domain="[('sale_order_id','=',False)]" name="no_catizado_filter"/>
                    <filter string="Cotizado" domain="[('sale_order_id','!=',False)]" name="catizado_filter"/>
                    <filter string="Docu. Completa" domain="[('documentacion','=','completa')]" name="completa_filter"/>
                    <filter string="Docu. Incompleta" domain="['|',('documentacion','=','incompleta'),('documentacion','=',False)]" name="incompleta_filter"/>
                    <filter string="Estado: Listo" domain="[('estado','=','listo')]" name="listo_filter"/>
                    <filter string="Estado: No Listo" domain="['|',('estado','=','no_listo'),('estado','=',False)]" name="no_listo_filter"/>
                    <filter string="Para Renovar" domain="[('alerta_renovacion','=',True)]" name="para_renovar"/>

                    <group expand="0" string="Group By">
                        <filter string="Cliente" name="cliente" domain="[]" context="{'group_by':'partner_id'}"/>
                        <filter name="product_id" string="Producto" domain="[]" context="{'group_by':'product_id'}"/>
                    </group>
               </search>
            </field>
        </record>

    <!-- explicit form view definition -->    
    <record model="ir.ui.view" id="arsante.modificacion_cosmetico_dm_form_view">
      <field name="name">Modificaciones Cosméticos</field>
      <field name="model">arsante.modificacion_cosmeticos</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
           <!-- <button string="Obtener Facturas" name="get_invoice_ids" type="object" class="oe_highlight"/>  -->
          </header>
          <sheet>
            <group>
              <group>
                <field name="tipo_registro_id" required="1"/>
                <field name="name" invisible="1"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"/>
                <field name="marcar_url" invisible="1"/>
                <label for="marcar"/>
                <div class="o_row">
                  <field name="marcar" class="oe_inline"/>
                  <button name="open_marcar_link" string="URL OneDrive" type="object"
                     icon="fa-folder-open" class="oe_link"
                     attrs="{'invisible': [('marcar_url', '=', False)]}"/>
                </div>
                <!-- <field name="mc_categoria"/> -->
                <field name="oc" />
                <!-- <field name="sku" /> -->
                <field name="mc_ref_gicona"/>
                <field name="mc_nro_registro"/>
                <field name="product_id"/>
                <field name="fabricante_id"/>
                <field name="nro_resolucion"/>
                  <field name="pdf_nro_resolucion" attrs="{'invisible': [('nro_resolucion','=',False)]}"/>
                  <field name="fecha_resolucion" attrs="{'invisible': [('nro_resolucion','=',False)]}"/>

                <field name="sale_order_id" attrs="{'invisible': [('sale_order_id','=',False)]}"/>

                <!-- <field name="no_cotizado"/> -->
                <field name="espera_resolucion"/>
                  <!-- <field name="documentacion"/> -->
                <!-- <field name="requiere_renovacion"/> -->
                <field name="fecha_renovacion"/>
                <field name="correo_ids" widget="many2many_tags" options="{'no_create_edit': True}" context="{'default_modificacion_cosmetico_id': id}"/>                
                <field name="comentario"/>
                  <field name="alerta_renovacion" invisible="1"/>
              </group>
              <group>
                <field name="imagen" widget="image" options="{'size': [300, 300]}"/>
              </group>
              <group invisible="1">
                <label for="enviar_colilla"/>
                <div class="o_row">
                  <field name="enviar_colilla" placeholder="Envíar colilla?" />
                  <field name="enviar_colilla_fecha" placeholder="Fecha enviar colilla" attrs="{'invisible': [('enviar_colilla','=',False)]}"/>
                </div>
                <field name="eximicion"/>  
                <field name="enviar_cliente"/>  
                <field name="estado"/>  
                <field name="facturado"/>  
                <field name="Subir_resol_drive"/>  
                <field name="requiere_renovacion"/>
                <field name="fecha_renovacion" attrs="{'invisible': [('requiere_renovacion','=',False)]}"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>
     
    <!-- explicit list view definition -->
    
    <record model="ir.ui.view" id="arsante.modificacion_cosmetico_dm_tree_view">
      <field name="name">Modificaciones Cosméticos</field>
      <field name="model">arsante.modificacion_cosmeticos</field>
      <field name="arch" type="xml">
        <tree>
                <field name="name" required="1"/>
                <field name="date" required="1"/>
                <field name="partner_id" required="1"/>
                <!-- <field name="mc_categoria"/> -->
                <field name="mc_ref_gicona"/>
                <field name="mc_nro_registro"/>
                <field name="product_id"/>
                <field name="fabricante_id"/>
                <field name="nro_resolucion"/>
                <field name="fecha_resolucion"/>
                <field name="sale_order_id" attrs="{'invisible': [('sale_order_id','=',False)]}"/>
                <field name="facturado"/>
                <!-- <field name="no_cotizado"/> -->
                <field name="espera_resolucion"/>
                  <field name="estado"/>
                  <field name="documentacion"/>
          <field name="alerta_renovacion"/>
        </tree>
      </field>
    </record>
   
       <!-- explicit pivot definition -->
    
    <record model="ir.ui.view" id="arsante.modificacion_cosmetico_pivot_view">
      <field name="name">CDA Cosméticos DM</field>
      <field name="model">arsante.modificacion_cosmeticos</field>
      <field name="arch" type="xml">
        <pivot>
          <field name="partner_id" type="row"/>
        </pivot>
      </field>
    </record>

    <!-- actions opening views on models -->
    
    <record model="ir.actions.act_window" id="arsante.modificaciones_cosmetico_action_window">
      <field name="name">Modificaciones Cosméticos</field>
      <field name="res_model">arsante.modificacion_cosmeticos</field>
      <field name="view_mode">tree,form,pivot</field>
    </record>

    <record model="ir.actions.act_window" id="arsante.modificaciones_cosmetico_action_window_no_facturados">
      <field name="name">Modificaciones Cosméticos - No Fcaturados</field>
      <field name="res_model">arsante.modificacion_cosmeticos</field>
      <field name="view_mode">tree,form,pivot</field>
      <field name="domain">[('facturado', '=', False)]</field>        
    </record>      
   
            <!-- Accion que crear las notas de ventas de varios registros seleccionados en la vista tree -->
            <record model="ir.actions.server" id="arsante.create_so_modificacion_cosmeticos_action_server">
                <field name="name">Crear Nota de Venta</field>
                <field name="type">ir.actions.server</field>
                <field name="model_id" ref="arsante.model_arsante_modificacion_cosmeticos"/>
                <field name="binding_model_id" ref="arsante.model_arsante_modificacion_cosmeticos"/>
                <field name="state">code</field>
                <field name="code">
                  record.create_so()
                </field>
              </record>        
   
    <!-- actions -->
    <menuitem name="Modificaciones Cosméticos" id="arsante.modificaciones_cosmetico_menu_list" parent="arsante.arsante_menu_tipo_registros"
              action="arsante.modificaciones_cosmetico_action_window"/>
   
  </data>
</odoo>